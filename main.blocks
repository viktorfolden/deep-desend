<value name="background"><shadow type="colorindexpicker" id="y,DfDtf9,?OzA6R|T/-F"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="vL8JRw_by=,WP?d;k#+;"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="Q_8]nQ1]Wfk,KGNZQ[[7"><field name="VAR" id="i^DiVWx7nwrO5-bx5:Qi">npc2</field></block></value><value name="text"><shadow type="text" id="tpc_C92J6d90is$kITqJ"><field name="TEXT">and infecting it with goblin flowers</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="a]5}o`[O+^2{nis2J^j3"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="[roLu`iJe{J@m/;%`$*0"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="vi1[uj|${i6-9wkt+dk5"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="WB=%Bf]0FjHNDW_y%_JQ"><field name="VAR" id="i^DiVWx7nwrO5-bx5:Qi">npc2</field></block></value><value name="text"><shadow type="text" id="!:ZOjeigAI8e9~ZqL[{*"><field name="TEXT">but now i can mine in peace</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="?2D|-A*1VHsVTc%m+Tg;"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="L94Bvj]:#6?G%Ulf%B`Q"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id=";,jpC~,t,7.U:d$e5%1M"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="hv|I`AwE!ryy?n}1}kQ#"><field name="VAR" id="i^DiVWx7nwrO5-bx5:Qi">npc2</field></block></valu